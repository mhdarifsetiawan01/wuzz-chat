{
  "expo": {
    "name": "WuzzChat",
    "slug": "wuzz-chat",
    "scheme": "wuzzchat",
    "version": "1.13.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "19",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "WuzzChat memerlukan izin akses mikrofon untuk melakukan panggilan suara dan mengirim pesan audio."
      }
    },
    "android": {
      "package": "com.wuzzchat.mobile",
      "versionCode": 19,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0462E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "wuzzchat"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chat.wuzzhub.id",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "chat.wuzzhub.id",
              "pathPrefix": "/g"
            },
            {
              "scheme": "https",
              "host": "chat.wuzzhub.id",
              "pathPrefix": "/sub"
            },
            {
              "scheme": "https",
              "host": "chat.wuzzhub.id",
              "pathPrefix": "/room"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-audio",
      "@config-plugins/react-native-webrtc",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0462E8"
        }
      ],
      "./plugins/withAndroidEdgeToEdgeKeyboard",
      "./plugins/withAndroidReleaseOptimization",
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0462E8",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
