# ==============================================================================
# WUZZ CHAT - BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Port server backend Go
PORT=8080

# CORS & WebSocket Allowed Origins (Bisa: "*" atau daftar koma domain, e.g. "http://localhost:3000,http://localhost:3047,https://wuzz-chat.vercel.app,https://*.vercel.app")
CORS_ALLOWED_ORIGINS=*

# JWT Secret Key (Gunakan string acak yang kuat untuk produksi)
JWT_SECRET=your_super_secret_jwt_key_wuzz_chat_2026

# ==============================================================================
# REDIS CLUSTER PUB/SUB & CACHE (FASE 6)
# ==============================================================================
# Digunakan untuk sinkronisasi pesan antar multi-instance server (Upstash / Redis Cloud / Lokal)
# Jika dikosongkan, sistem otomatis menggunakan InMemoryBroker (Mode Lokal).
#
# Contoh Upstash Redis (TCP TLS):
# REDIS_URL=rediss://default:your_token@your-endpoint.upstash.io:6379
#
# Contoh Redis Lokal:
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PILIHAN 1: Menggunakan Connection String Lengkap (Direkomendasikan untuk Supabase)
# Jika DATABASE_URL diisi, konfigurasi individual di bawah akan diabaikan.
#
# Contoh Supabase / PostgreSQL Cloud:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Contoh PostgreSQL Lokal:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wuzzchat?sslmode=disable
#
# Contoh SQLite Lokal (file):
# DATABASE_URL=sqlite://wuzz.db
#
DATABASE_URL=

# PILIHAN 2: Menggunakan Parameter Individual
# Driver yang didukung: "postgres", "sqlite", "memory"
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=wuzzchat
DB_SSLMODE=disable

# Nama file jika DB_DRIVER=sqlite
SQLITE_DB_PATH=wuzz.db

# ==============================================================================
# MEDIA STORAGE & STORE-AND-FORWARD LIFECYCLE (FASE 5)
# ==============================================================================

# Driver Storage yang didukung: "supabase" atau "local"
STORAGE_DRIVER=local

# Konfigurasi Supabase Storage (Wajib jika STORAGE_DRIVER=supabase)
# Gunakan Service Role Key (bukan anon key) agar backend memiliki hak upload & delete
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=wuzz-chat-media

# Konfigurasi Local Storage (Digunakan jika STORAGE_DRIVER=local)
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PATH=/uploads/

# Pengaturan Fitur & Kebijakan Retensi Media (WhatsApp-Style Store-and-Forward)
ENABLE_MEDIA_UPLOAD=true
MAX_UPLOAD_SIZE_MB=50
MEDIA_RETENTION_DAYS=7
MEDIA_AUTO_DELETE_ON_DOWNLOAD=true

# ==============================================================================
# WEB PUSH NOTIFICATIONS (VAPID)
# ==============================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@wuzzhub.id

# ==============================================================================
# DATABASE CONNECTION POOL TUNING
# ==============================================================================
# Jumlah maksimal jalur koneksi database bersamaan (default: 25)
DB_MAX_OPEN_CONNS=25

# Jumlah koneksi standby siap pakai tanpa TLS handshake baru (default: 10)
DB_MAX_IDLE_CONNS=10

# Waktu recycle koneksi dalam menit untuk mencegah koneksi basi/zombie (default: 5)
DB_CONN_MAX_LIFETIME_MINUTES=5

# Batas waktu pelepasan koneksi idle dalam menit (default: 2)
DB_CONN_MAX_IDLE_TIME_MINUTES=2

# ==============================================================================
# AUTH RATE LIMITING (DUAL-TIER)
# ==============================================================================
# Batas request login/register per menit per alamat IP publik (Anti-DDoS, default: 100)
AUTH_RATE_LIMIT_IP=100

# Batas request login/register per menit per username (Anti-Brute Force, default: 15)
AUTH_RATE_LIMIT_USER=15

# ==============================================================================
# GROUP MEMORY AI & LLM ENGINE (MILESTONE 7)
# ==============================================================================
# Provider AI yang digunakan untuk ekstraksi memori & ringkasan forum kedaluwarsa.
# Opsi yang didukung: "gemini", "groq", "mock" (default: "gemini")
AI_PROVIDER=gemini

# Pengaturan Google Gemini (Digunakan jika AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Pengaturan Groq Cloud (Digunakan jika AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Hyperparameter Pemanggilan AI
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.2

# Konfigurasi Pemrosesan Pesan Forum AI
# Batas maksimal pesan percakapan yang dianalisis oleh engine AI (default: 1000)
MEMORY_MAX_MESSAGES_ANALYSIS=1000
# Batas maksimal panjang karakter preview kutipan pesan evidence (default: 200)
MEMORY_EVIDENCE_MAX_PREVIEW_LEN=200

# Konfigurasi Background Worker & Job Queue
# Jeda interval polling antrean background worker dalam detik (default: 15)
MEMORY_WORKER_INTERVAL_SECONDS=15
# Jumlah job per batch yang diambil dalam satu iterasi worker (default: 5)
MEMORY_JOB_BATCH_SIZE=5
# Batas maksimal percobaan job sebelum ditandai FAILED secara permanen (default: 3)
MEMORY_JOB_MAX_ATTEMPTS=3

# Konfigurasi Backoff Retry Delay (Negative Handling / Rate Limit Recovery)
MEMORY_RETRY_DELAY_1=30s
MEMORY_RETRY_DELAY_2=2m
MEMORY_RETRY_DELAY_3=8m


